---
import '../styles/global.css';
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Consulta de programación · EPG UNAP</title></head><body><header class="bg-[#102a4a] text-white"><div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4"><a href="/" class="font-extrabold">EPG <span class="text-amber-300">UNAP</span><span class="ml-3 border-l border-white/20 pl-3 text-sm font-medium text-slate-200">Admisión</span></a></div></header><main class="mx-auto max-w-3xl px-5 py-10 md:py-14"><p class="text-xs font-bold uppercase tracking-[.13em] text-blue-700">Admisión 2026-II</p><h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Consulta tu programación</h1><p class="mt-3 max-w-xl leading-7 text-slate-600">Conoce dónde rendirás tu examen y dónde te corresponde la entrevista.</p><section class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm md:p-8"><h2 class="text-lg font-bold text-slate-950">Ingresa tu documento</h2><p class="mt-1 text-sm text-slate-500">Utiliza el mismo DNI que registraste en tu inscripción.</p><form id="form" class="mt-6"><label for="dni" class="block text-sm font-semibold">DNI</label><div class="mt-2 flex flex-wrap gap-3"><input id="dni" name="dni" inputmode="numeric" pattern="[0-9]{8}" minlength="8" maxlength="8" autocomplete="off" placeholder="Ingresa tus 8 dígitos" required class="h-12 min-w-48 flex-1 rounded-lg border border-slate-300 px-4"/><button class="h-12 rounded-lg bg-blue-800 px-6 text-sm font-semibold text-white hover:bg-blue-900">Consultar programación</button></div></form><div id="result" role="status" aria-live="polite" class="mt-5"></div></section><p class="mt-5 text-xs leading-5 text-slate-500">Información del corte del 13 de noviembre de 2026 a las 13:12. Si necesitas confirmar algún dato, comunícate con Admisión.</p></main></body></html>
<script>
const form=document.querySelector<HTMLFormElement>('#form')!,result=document.querySelector<HTMLElement>('#result')!;
form.addEventListener('submit',async event=>{event.preventDefault();result.textContent='Consultando…';try{const dni=String(new FormData(form).get('dni'));const response=await fetch('http://127.0.0.1:4351/api/consulta',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({dni})});const data=await response.json();if(!response.ok)throw new Error(data.error);result.replaceChildren();if(!data.actividades.length){result.textContent='No encontramos programación para el DNI ingresado.';return;}for(const item of data.actividades){const box=document.createElement('article');box.className='mt-4 rounded-lg border border-slate-200 bg-slate-50 p-4';const title=document.createElement('h3');title.className='font-bold text-slate-900';title.textContent=item.tipo==='examen'?'Examen de conocimientos':'Entrevista personal';box.append(title);for(const text of [item.programa,`Aula: ${item.aula}`,item.fecha?`Fecha: ${item.fecha}`:'',item.aula_espera?`Aula de espera: ${item.aula_espera}`:'',item.sede?`Sede: ${item.sede}`:'',item.instrucciones]){if(!text)continue;const p=document.createElement('p');p.className='mt-1 text-sm leading-6 text-slate-600';p.textContent=text;box.append(p);}result.append(box);}}catch(error){result.textContent=error instanceof Error?error.message:'No se pudo consultar.';}});
</script>
