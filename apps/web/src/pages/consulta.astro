---
import Base from '../layouts/Base.astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import CargandoPagina from '../components/CargandoPagina.astro';
---
<Base title="Consulta de programación · EPG UNAP">
  <Cabecera />

  <main>
    <section class="mx-auto max-w-[1200px] px-6 pb-20 pt-10 md:px-12 md:pb-28 md:pt-16">
      <div class="grid gap-10 lg:grid-cols-[1fr_400px] lg:items-end">
        <h1 class="text-[44px] leading-[0.98] tracking-[-1.4px] sm:text-[64px] sm:tracking-[-2px] lg:text-[80px] lg:tracking-[-2.4px]">
          ¿Dónde<br />me toca<br /><span class="text-brand">presentarme?</span>
        </h1>
        <p class="font-serif text-base leading-[1.4] text-iron">
          Ingresa tu DNI y te mostramos tus datos, el aula y la fecha de tu examen de conocimientos y de tu entrevista personal.
        </p>
      </div>

      <form id="form" class="mt-14 max-w-[720px]" novalidate>
        <label for="dni" class="label">Documento de identidad</label>
        <div class="mt-3 flex flex-wrap gap-2">
          <input id="dni" name="dni" inputmode="numeric" pattern="[0-9]{8}" minlength="8" maxlength="8"
            autocomplete="off" placeholder="8 dígitos de tu DNI" required class="field min-w-56 flex-1" />
          <button type="submit" id="submit" class="btn-primary">Consultar programación</button>
        </div>
        <p id="hint" role="status" aria-live="polite" class="mt-3 text-sm text-graphite">Utiliza el mismo DNI que registraste en tu inscripción.</p>
      </form>
    </section>
  </main>

  <Pie />
  <CargandoPagina />
</Base>

<script>
  import '../scripts/consulta.ts';
</script>
