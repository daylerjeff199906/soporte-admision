# Copia este archivo a .env y completa los valores. .env NO se sube a Git.

# Acceso al panel interno (http://127.0.0.1:4350). Usa una contrasena larga y unica.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Clave para firmar las sesiones (si se omite, se genera y guarda en data/sesion.secret).
# Generar una: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Pon 1 cuando se sirva por HTTPS (marca la cookie como Secure)
COOKIE_SECURE=

# Catalogo institucional de aulas (opcional)
INTRANET_URL=
INTRANET_SERVICE_KEY=

# SIGAE (opcional; estos son los valores por defecto)
SIGAE_API_URL=https://api.postgradounap.edu.pe/
SIGAE_CONVOCATORIA=adc6bcb2-4935-48f0-9ed8-c55454aad806
